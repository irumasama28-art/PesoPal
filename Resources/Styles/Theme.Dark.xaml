<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <!-- Dark Theme Colors -->
  <Color x:Key="PageBackgroundColor">#0B1722</Color>
  <Color x:Key="SurfaceColor">#1A2332</Color>
  <Color x:Key="PrimaryColor">#0A58CA</Color>
  <Color x:Key="PrimaryDarkColor">#0847A1</Color>
  <Color x:Key="AccentColor">#00BCD4</Color>
  <Color x:Key="SuccessColor">#66BB6A</Color>
  <Color x:Key="WarningColor">#FFA726</Color>
  <Color x:Key="DangerColor">#EF5350</Color>

  <!-- Text Colors -->
  <Color x:Key="PrimaryTextColor">#E6EEF8</Color>
  <Color x:Key="SecondaryTextColor">#A3B1C2</Color>
  <Color x:Key="DisabledTextColor">#616161</Color>
  <Color x:Key="HintTextColor">#757575</Color>

  <!-- Backgrounds & Borders -->
  <Color x:Key="BorderColor">#2C3E50</Color>
  <Color x:Key="DividerColor">#34495E</Color>
  <Color x:Key="CardBackgroundColor">#1A2332</Color>
  <Color x:Key="InputBackgroundColor">#151E2B</Color>

  <!-- Status Colors -->
  <Color x:Key="IncomeColor">#66BB6A</Color>
  <Color x:Key="ExpenseColor">#EF5350</Color>
  <Color x:Key="NeutralColor">#BDBDBD</Color>

</ResourceDictionary>
