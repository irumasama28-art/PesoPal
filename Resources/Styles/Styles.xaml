<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:controls="clr-namespace:CashLedgerAndroid.Controls;assembly=CashLedgerAndroid"
                    x:Class="CashLedgerAndroid.Resources.Styles.Styles">

  <!-- Label styles -->
  <Style TargetType="Label" x:Key="HeaderLabel">
    <Setter Property="FontSize" Value="{StaticResource FontSizeH1}" />
    <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyDefault}" />
  </Style>

  <Style TargetType="Label" x:Key="BodyLabel">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyDefault}" />
  </Style>

  <!-- Button style with touch-target and press behavior -->
  <Style TargetType="Button" x:Key="PrimaryButton">
    <Setter Property="HeightRequest" Value="48" />
    <Setter Property="MinimumHeightRequest" Value="48" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="BackgroundColor" Value="{StaticResource Blue}" />
    <Setter Property="TextColor" Value="White" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyDefault}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="AutomationProperties.IsInAccessibleTree" Value="True" />
    <Setter Property="AutomationProperties.HelpText" Value="Primary action" />
    <!-- Attach ButtonPressBehavior in code or directly on controls to avoid XAML resolution issues for BehaviorCollection -->
  </Style>

  <!-- Entry style for touch targets -->
  <Style TargetType="Entry">
    <Setter Property="HeightRequest" Value="44" />
    <!-- Use Margin to adjust external spacing; avoid Padding which may not be available on all platforms/controls -->
    <Setter Property="Margin" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyDefault}" />
    <Setter Property="AutomationProperties.IsInAccessibleTree" Value="True" />
  </Style>

</ResourceDictionary>
