<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <!-- Light Theme Colors -->
  <Color x:Key="PageBackgroundColor">#EEF3FA</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="PrimaryColor">#0066F0</Color>
  <Color x:Key="PrimaryDarkColor">#0052C8</Color>
  <Color x:Key="AccentColor">#00BCD4</Color>
  <Color x:Key="SuccessColor">#4CAF50</Color>
  <Color x:Key="WarningColor">#FF9800</Color>
  <Color x:Key="DangerColor">#F44336</Color>

  <!-- Text Colors -->
  <Color x:Key="PrimaryTextColor">#0F1724</Color>
  <Color x:Key="SecondaryTextColor">#5B6B84</Color>
  <Color x:Key="DisabledTextColor">#BDBDBD</Color>
  <Color x:Key="HintTextColor">#9E9E9E</Color>

  <!-- Backgrounds & Borders -->
  <Color x:Key="BorderColor">#E0E0E0</Color>
  <Color x:Key="DividerColor">#D0D0D0</Color>
  <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
  <Color x:Key="InputBackgroundColor">#F5F5F5</Color>

  <!-- Status Colors -->
  <Color x:Key="IncomeColor">#4CAF50</Color>
  <Color x:Key="ExpenseColor">#F44336</Color>
  <Color x:Key="NeutralColor">#757575</Color>

</ResourceDictionary>
