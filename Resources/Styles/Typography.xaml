<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="CashLedgerAndroid.Resources.Styles.Typography">

  <!-- Typography scale -->
  <OnPlatform x:Key="FontFamilyDefault" x:TypeArguments="x:String">
    <On Platform="Android">sans-serif</On>
    <On Platform="iOS">System</On>
    <On Platform="WinUI">Segoe UI</On>
  </OnPlatform>

  <x:Double x:Key="FontSizeH1">28</x:Double>
  <x:Double x:Key="FontSizeH2">20</x:Double>
  <x:Double x:Key="FontSizeBody">15</x:Double>
  <x:Double x:Key="FontSizeSmall">13</x:Double>

</ResourceDictionary>
